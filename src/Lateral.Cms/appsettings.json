{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Data Source=App_Data/cms.db",
    "ReadConnectionString": null,
    "ApplyMigrationsOnStartup": true
  },
  "Ingestion": {
    "MaxBodyBytes": 5242880,
    "MaxBatchSize": 500,
    "MaxPayloadBytes": 262144,
    "MaxJsonDepth": 32,
    "MaxFutureSkew": "01:00:00"
  },
  "Inbox": {
    "WorkerEnabled": true,
    "PollInterval": "00:00:01",
    "MaxAttempts": 5,
    "RetryBaseDelay": "00:00:02",
    "RetryMaxDelay": "00:01:00",
    "FaultDelay": "00:00:05",
    "MaxBytes": 268435456
  },
  "Api": {
    "DefaultPageSize": 50,
    "MaxPageSize": 100
  },
  "Admin": {
    "AllowReset": false
  },
  "Auth": {
    "MaxFailuresPerMinute": 10
  }
}
