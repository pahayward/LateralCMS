{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Console": {
    "CmsBaseUrl": "http://localhost:5080",
    "Port": 5100,
    "Limits": {
      "MaxBodyBytes": 5242880,
      "MaxPayloadBytes": 262144,
      "MaxBatchSize": 500
    }
  }
}
